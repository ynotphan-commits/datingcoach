# Copy to .env and fill in. Never commit real secrets.
SECRET_KEY=change-me-to-a-long-random-string

# --- AI provider (pick one) ---
# AI_PROVIDER=gemini      # free tier, recommended for beta
# AI_PROVIDER=anthropic   # paid API
# AI_PROVIDER is optional: auto-picks gemini if GEMINI_API_KEY is set,
# else anthropic if ANTHROPIC_API_KEY is set.

# Google AI Studio free tier — get a key free (no card) at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (paid) — only needed if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/datingcoach
# MOCK_AI=true   # set to true for UI testing with canned AI responses (no API spend)
# PORT=8000
